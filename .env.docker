# .env.docker — template za Docker deployment
# Kopiraj vsebino v .env na strežniku ali nastavi kot environment file

# Generiraj z: php artisan key:generate --show
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY

# Produkcijski URL (brez trailing slash)
APP_URL=https://jakaphotography.si

# PostgreSQL
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@jakaphotography.si
